# Copy these values into your process environment or a local secret manager.
# Never commit or package real credentials.
MiniMax_API_KEY=
MiniMax_PROTOCOL=anthropic
MiniMax_BASE_URL=https://api.minimaxi.com/anthropic
MiniMax_MODEL=MiniMax-M2.7
AI_MANGA_MINIMAX_TIMEOUT_SECONDS=180

# Optional path overrides. Leave AI_FACTORY_ROOT blank to use this repository.
# Example (Windows): COMFYUI_ROOT=D:\AI\ComfyUI
# Example (Linux):   COMFYUI_ROOT=/opt/ComfyUI
AI_FACTORY_ROOT=
COMFYUI_ROOT=
COMFYUI_SERVER=http://127.0.0.1:8188
AI_FACTORY_PORT=8501
PYTHON_EXE=
FFMPEG_PATH=
FFPROBE_PATH=
